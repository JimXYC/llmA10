{
    "model_to_train": "models/GPTNeoX-160m",
    "output_dir": "models/GPTNeoX-160M-WikiText-2048-scratch",
    "run_name": "GPTNeoX-160M-WikiText-2048-scratch",
    "report_to": "wandb",
    "eval_strategy": "epoch",
    "logging_steps": 25,
    "num_train_epochs": 1,
    "save_strategy": "no",
    "bf16": true,
    "seq_len": 2048,
    "attention_type": "flash_attention_2",
    "gradient_checkpointing": true,
    "dataset": "wikitext",
    "deepspeed": null,
    "per_device_train_batch_size": 4,
    "learning_rate": 0.0001,
    "weight_decay": 0.1,
    "warmup_ratio": 0.01,
    "lr_scheduler_type": "cosine",
    "per_device_eval_batch_size": 2,
    "seed": 42,
    "data_seed": 42,
    "optim": "adamw_torch",
    "adam_beta1": 0.9,
    "adam_beta2": 0.95,
    "adam_epsilon": 1e-08,
    "max_grad_norm": 1.0,
    "disable_tqdm": true,
    "dataloader_num_workers": 2,
    "gradient_accumulation_steps": 2,
    "gradient_checkpointing_kwargs": {
        "use_reentrant": false
    }
}
